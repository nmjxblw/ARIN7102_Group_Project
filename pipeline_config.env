# ============================================================
# Drug Recommendation Pipeline - 参数配置文件
# ============================================================
# 本文件集中管理推荐管道的所有可调参数。
# 修改后无需改代码，重启服务即可生效。
#
# 使用方式：
#   1. 放在项目根目录下（与 .env 同级）
#   2. 所有脚本（run_recommend.py, run_evaluate.py, FastAPI 服务）
#      启动时自动加载此文件
# ============================================================


# ────────────────────────────────────────────────────────────
# 召回阶段 (Recall Stage)
# ────────────────────────────────────────────────────────────

# 每个召回通道保留的候选药物数量
# 越大召回率越高，但精排耗时线性增长（CPU 上每 100 条约 6s）
# 推荐范围: 100~500
RECALL_TOP_K_EACH=200

# 双路融合后保留的候选数（送入 CrossEncoder 精排的数量）
# 通常等于 RECALL_TOP_K_EACH 或更小
FUSED_TOP_K=200

# 语义召回权重（语义通道在融合时的权重）
# 语义 + 标签 不必严格加和为 1，会按比例归一化
RECALL_WEIGHT_SEMANTIC=0.5

# 标签召回权重（标签通道在融合时的权重）
RECALL_WEIGHT_LABEL=0.5

# ────────────────────────────────────────────────────────────
# 标签召回内部权重 (Label Recall Internal Weights)
# ────────────────────────────────────────────────────────────

# 疾病匹配在标签召回中的权重
# label_score_raw = DISEASE_WEIGHT × disease_overlap + SYMPTOM_WEIGHT × symptom_overlap
LABEL_DISEASE_WEIGHT=0.55

# 症状匹配在标签召回中的权重
LABEL_SYMPTOM_WEIGHT=0.45

# ────────────────────────────────────────────────────────────
# 精排阶段 - 最终得分权重 (Rerank / Final Score Weights)
# ────────────────────────────────────────────────────────────
# final_score = FINAL_W_RECALL × recall_fused_score
#             + FINAL_W_CROSS_ENCODER × cross_encoder_score
#             + FINAL_W_BUSINESS × business_score
#
# 三者加和应为 1.0

# 召回融合分权重（体现"标签+语义"的贡献）
FINAL_WEIGHT_RECALL=0.35

# CrossEncoder 精排分权重（体现 query-drug 文本对的语义相关性）
FINAL_WEIGHT_CROSS_ENCODER=0.50

# 业务因子权重（体现评分、评论数、价格等业务信号）
FINAL_WEIGHT_BUSINESS=0.15

# ────────────────────────────────────────────────────────────
# 业务评分内部权重 (Business Score Internal Weights)
# ────────────────────────────────────────────────────────────
# business_score = BIZ_W_RATING × rating_normalized
#                + BIZ_W_REVIEWS × log_reviews_normalized
#                + BIZ_W_PRICE × (1 - price_normalized)
#
# 三者加和应为 1.0

# 平均评分权重（来自用户评分数据）
BIZ_WEIGHT_RATING=0.55

# 评论数权重（对数归一化后的评论数量）
BIZ_WEIGHT_REVIEWS=0.30

# 价格权重（越低越好）
BIZ_WEIGHT_PRICE=0.15

# ────────────────────────────────────────────────────────────
# 输出参数 (Output Parameters)
# ────────────────────────────────────────────────────────────

# 最终返回的药物数量
TOP_K=10

# ────────────────────────────────────────────────────────────
# 模型配置 (Model Configuration)
# ────────────────────────────────────────────────────────────

# 语义编码模型（用于生成药物向量和 query 向量）
MEDBERT_MODEL_NAME=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract

# CrossEncoder 精排模型
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ────────────────────────────────────────────────────────────
# 数据路径 (Data Paths)
# ────────────────────────────────────────────────────────────
# 路径配置已在 app/.env 中管理，此处仅作参考：
# DRUG_TABLE_PATH=../match_data_preprocessing/data/enhanced_drug_table_v1_structured.csv
# DRUG_EMBEDDING_PATH=../drug_comprehensive_embeddings.npy
# TRAINED_BERT_SAVE_PATH=deployment_module/trained_bert
# EVAL_DATASET_PATH=../match_data_preprocessing/data/eval_dataset_verified.json
